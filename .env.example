ANTHROPIC_API_KEY=
BREVO_API_KEY=
BREVO_LIST_ID=
DATABASE_URL=sqlite:///./spf.db

# NewsAPI est facultatif : la couche mots-clés passe par Google News RSS.
# Renseigner cette clé n'active la source "newsapi" que si tu l'ajoutes
# à NEWS_SOURCES dans src/config.py.
NEWSAPI_KEY=

# Interface de validation.
# Génère APP_SECRET_KEY et REVIEWER_PASSWORD_HASH d'un coup avec :
#   python -m src.app.security
APP_SECRET_KEY=
REVIEWER_PASSWORD_HASH=
ALLOWED_REVIEWER_EMAILS=bureau@sciencespo.fr,president@sciencespo.fr

# Durée d'une session de relecture, en secondes (12 h par défaut).
SESSION_MAX_AGE_SECONDS=43200
# Passer à false uniquement pour un développement local en HTTP.
COOKIE_SECURE=true
